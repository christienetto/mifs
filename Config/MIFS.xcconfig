// Build settings shared by every target and configuration (see project.yml).

// Where the app and the Messages extension find the MIFS music server (server/README.md).
// The simulator reaches the Mac's server on localhost. `//` starts a comment in xcconfig
// files, hence the `$()` inside the URL. Leave empty to hide the MIFS Library.
MIFS_SERVER_URL = http:/$()/localhost:8080

// Machine-specific overrides, e.g. your Mac's LAN address for a physical iPhone.
// Copy Local.xcconfig.example to Local.xcconfig (git-ignored).
#include? "Local.xcconfig"
