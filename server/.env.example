# Copy to server/.env (git-ignored); `make run` loads it.

# Accept connections from a phone on your Wi-Fi (Config/Local.xcconfig points the app here).
MIFS_ADDR=:8080

# Spotify search: create an app at https://developer.spotify.com/dashboard (Web API) and
# copy its Client ID and Client Secret. Development-mode apps need a Premium owner.
MIFS_SPOTIFY_CLIENT_ID=
MIFS_SPOTIFY_CLIENT_SECRET=
# MIFS_SPOTIFY_MARKET=US

# Spotify is the only search source. Install spotDL with `make -C server setup` (or pipx install spotdl).
# The worker downloads each selected song once; ffmpeg and ffprobe must also be on PATH.
MIFS_DISCOVERY=spotify
# MIFS_SPOTDL=/absolute/path/to/spotdl

# Optional sources before spotDL, or an explicit command override for testing:
# MIFS_LIBRARY_DIR=/Users/you/Music/MIFS
# MIFS_AUDIO_COMMAND=scripts/test-tone.sh

# Public sharing and native Universal Links (leave unset for local testing).
# Match the host in Config/Local.xcconfig's MIFS_SERVER_URL and MIFS_LINK_HOST.
# MIFS_PUBLIC_URL=https://mifs.example.com
# MIFS_IOS_APP_ID=YOUR_TEAM_ID.com.yourcompany.mifs
