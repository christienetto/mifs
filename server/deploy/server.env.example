# Install as /home/mifs/.config/mifs/server.env, owned by mifs, mode 0600.
# Without these credentials, the demo catalog works but Spotify search is disabled.
MIFS_SPOTIFY_CLIENT_ID=
MIFS_SPOTIFY_CLIENT_SECRET=
MIFS_DISCOVERY=spotify
MIFS_LYRICS=lrclib
MIFS_WORKERS=2
# Optional authenticated audio source; first mount this private file into the container.
# MIFS_SPOTDL_COOKIE_FILE=/run/mifs/youtube-cookies.txt
